<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vesper.App.ViewModels"
             xmlns:prof="using:Vesper.Core.Profiles"
             xmlns:ver="using:Vesper.Core.Versions"
             xmlns:ld="using:Vesper.Core.Loaders"
             xmlns:ctrl="using:Vesper.App.Controls"
             x:Class="Vesper.App.Views.PlayView"
             x:DataType="vm:PlayViewModel">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ── Top Toolbar ────────────────────────────────────────── -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="22,18,22,14">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
        <TextBlock Text="INSTANCES" FontSize="18" FontWeight="Bold"
                   FontFamily="{StaticResource FontDisplay}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center"/>
        <Border Background="{DynamicResource BgCardBrush}" CornerRadius="8" Padding="9,4"
                VerticalAlignment="Center" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
          <TextBlock Text="{Binding Profiles.Count, StringFormat='{}{0} profiles'}"
                     FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
        <!-- New Instance button -->
        <Button Classes="primary" Padding="18,9" CornerRadius="11"
                Command="{Binding BeginCreateProfileCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconPlus}"
                  Stroke="{DynamicResource AccentContrastBrush}"/>
            <TextBlock Text="New Instance" VerticalAlignment="Center" FontWeight="Bold" FontSize="12.5"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- ── Main Grid: Basalt Instance Cards ──────────────────── -->
    <ScrollViewer Grid.Row="1" Margin="22,0,22,0">
      <StackPanel Spacing="16">

        <!-- New Profile Creator Modal (Inline Card) -->
        <Border Classes="settingCard riseIn" Margin="0,0,0,10" Padding="18"
                IsVisible="{Binding IsCreatingProfile}">
          <StackPanel Spacing="12">
            <TextBlock Classes="label" Text="CREATE NEW INSTANCE" FontSize="12"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="INSTANCE NAME" Classes="label"/>
                <TextBox Classes="field" PlaceholderText="e.g. My Modpack"
                         Text="{Binding NewProfileName, Mode=TwoWay}"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="MINECRAFT VERSION" Classes="label"/>
                <ComboBox Classes="field"
                          ItemsSource="{Binding GroupVersions}"
                          PlaceholderText="{Binding VersionPlaceholder}"
                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="ver:MinecraftVersionInfo">
                      <TextBlock Text="{Binding Id}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="MOD LOADER" Classes="label"/>
                <ComboBox Classes="field"
                          ItemsSource="{Binding AvailableLoaders}"
                          SelectedItem="{Binding SelectedLoaderChoice, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoaderChoice">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Grid>

            <TextBlock Classes="subtitle" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}"
                       Text="{Binding EnhancedHint}"
                       IsVisible="{Binding EnhancedUnavailable}"/>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
              <Button Classes="ghost" Padding="16,8" Content="Cancel"
                      Command="{Binding CancelCreateProfileCommand}"/>
              <Button Classes="primary" Padding="20,8" Content="Create Instance"
                      Command="{Binding ConfirmCreateProfileCommand}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Instances Grid -->
        <ItemsControl ItemsSource="{Binding Profiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="prof:Profile">
              <Button Classes="versionCard riseIn" Margin="0,0,14,14" Height="185"
                      HorizontalAlignment="Stretch"
                      Command="{Binding $parent[UserControl].((vm:PlayViewModel)DataContext).SelectProfileCommand}"
                      CommandParameter="{Binding}">
                <Border CornerRadius="16" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                  <Panel>
                    <!-- Background Cover Artwork -->
                    <Image Source="{Binding MinecraftVersion, Converter={x:Static ctrl:ProfileBannerConverter.Instance}}"
                           Stretch="UniformToFill" Opacity="0.9" />

                    <!-- Dark Gradient Overlay -->
                    <Border>
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                          <GradientStop Color="#55000000" Offset="0"/>
                          <GradientStop Color="#11000000" Offset="0.3"/>
                          <GradientStop Color="#77000000" Offset="0.6"/>
                          <GradientStop Color="#F00A0A0E" Offset="1"/>
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>

                    <!-- Top Badges -->
                    <Grid ColumnDefinitions="*,Auto" Margin="12,12,12,0" VerticalAlignment="Top">
                      <!-- Version pill -->
                      <Border Grid.Column="0" Background="#99000000" CornerRadius="7" Padding="8,4"
                              HorizontalAlignment="Left">
                        <TextBlock Text="{Binding MinecraftVersion}" FontSize="11" FontWeight="Bold"
                                   Foreground="White"/>
                      </Border>

                      <!-- Loader pill -->
                      <Border Grid.Column="1" Background="{DynamicResource AccentBrush}"
                              CornerRadius="7" Padding="8,4">
                        <TextBlock Text="{Binding ProfileLabel}" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentContrastBrush}"/>
                      </Border>
                    </Grid>

                    <!-- Bottom Details -->
                    <Grid ColumnDefinitions="*,Auto" Margin="14,0,14,14" VerticalAlignment="Bottom">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                   FontFamily="{StaticResource FontDisplay}"
                                   Foreground="White"/>
                        <TextBlock Text="{Binding LastPlayedLabel}" FontSize="11"
                                   Foreground="#B0FFFFFF"/>
                      </StackPanel>

                      <!-- Delete button -->
                      <Button Grid.Column="1" Classes="chrome" Width="30" Height="30"
                              Command="{Binding $parent[UserControl].((vm:PlayViewModel)DataContext).DeleteProfileCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconTrash}"/>
                      </Button>
                    </Grid>

                  </Panel>
                </Border>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty State when 0 instances exist -->
        <Border Classes="settingCard riseIn" Padding="36,44" Margin="0,20,0,0" HorizontalAlignment="Center"
                IsVisible="{Binding HasNoProfiles}">
          <StackPanel Spacing="14" HorizontalAlignment="Center">
            <Path Data="{StaticResource IconBox}" Width="44" Height="44"
                  Stroke="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Opacity="0.8"/>
            <TextBlock Text="No Instances Created Yet" FontSize="18" FontWeight="Bold"
                       FontFamily="{StaticResource FontDisplay}" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Create your first custom Minecraft instance by clicking '+ New Instance'."
                       FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <Button Classes="primary" Padding="20,10" CornerRadius="11" HorizontalAlignment="Center"
                    Command="{Binding BeginCreateProfileCommand}" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconPlus}"
                      Stroke="{DynamicResource AccentContrastBrush}"/>
                <TextBlock Text="+ New Instance" VerticalAlignment="Center" FontWeight="Bold" FontSize="12.5"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ── Bottom Hero Launch Bar (Basalt Style) ─────────────── -->
    <Border Grid.Row="2" Background="{DynamicResource BgElevatedBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
            Padding="22,14,22,16">
      <Grid ColumnDefinitions="*,Auto,Auto">

        <!-- Selected Profile Summary -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Border Width="48" Height="48" CornerRadius="12" ClipToBounds="True">
            <Image Source="{Binding SelectedProfile.MinecraftVersion, Converter={x:Static ctrl:ProfileBannerConverter.Instance}}"
                   Stretch="UniformToFill"/>
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue='Select an instance'}"
                       FontSize="16" FontWeight="Bold"
                       FontFamily="{StaticResource FontDisplay}"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding SelectedProfile.ProfileLabel, FallbackValue='No instance selected'}"
                         FontSize="11.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
              <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
              <TextBlock Text="{Binding SelectedProfile.MinecraftVersion}"
                         FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Manage Mods Button -->
        <Button Grid.Column="1" Classes="ghost" Margin="0,0,16,0" VerticalAlignment="Center"
                Command="{Binding OpenModsCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconBox}"/>
            <TextBlock Text="Manage Mods" VerticalAlignment="Center" FontSize="12.5"/>
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="2" Spacing="7" VerticalAlignment="Center" Width="220">
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsBusy}">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat='{}{0:0}%'}"
                       FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"
                       Foreground="{DynamicResource AccentBrush}"
                       IsVisible="{Binding !IsLoadingLoaders}" />
          </Grid>
          <ProgressBar Height="8" CornerRadius="4" Value="{Binding Progress}" Maximum="100"
                       IsIndeterminate="{Binding IsLoadingLoaders}"
                       IsVisible="{Binding IsBusy}"/>

          <Panel>
            <Border Classes="glowPulse" CornerRadius="13" Margin="-6"
                    Background="{DynamicResource AccentBrush}"
                    IsVisible="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Button Classes="primary" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    FontSize="14.5" Padding="0,14" CornerRadius="12"
                    IsEnabled="{Binding !IsBusy}"
                    Command="{Binding LaunchCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="icon solid" Width="16" Height="16"
                      Fill="{DynamicResource AccentContrastBrush}"
                      Data="{StaticResource IconPlay}"/>
                <TextBlock VerticalAlignment="Center" FontWeight="Bold" LetterSpacing="1"
                           Text="{Binding LaunchButtonText}"/>
              </StackPanel>
            </Button>
          </Panel>
        </StackPanel>

      </Grid>
    </Border>

  </Grid>
</UserControl>
