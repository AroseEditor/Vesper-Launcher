<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Vesper.App.ViewModels"
        xmlns:views="using:Vesper.App.Views"
        xmlns:acc="using:Vesper.Core.Accounts"
        xmlns:ctrl="using:Vesper.App.Controls"
        x:Class="Vesper.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Vesper Launcher"
        Width="1240" Height="780"
        MinWidth="1060" MinHeight="680"
        Background="{DynamicResource BgBaseBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="46,*">

    <Border Grid.Row="0" Name="TitleBar"
            Background="{DynamicResource BgElevatedBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPressed">
      <Grid ColumnDefinitions="*,Auto,Auto">

        <Button Grid.Column="1" Name="AccountButton" Classes="chrome"
                Width="NaN" Padding="9,0" Margin="0,6,10,6"
                Command="{Binding Accounts.TogglePopupCommand}">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Border Width="26" Height="26" CornerRadius="8" ClipToBounds="True"
                    Background="{DynamicResource AccentDeepBrush}">
              <Panel>
                <TextBlock Text="{Binding Accounts.SelectedInitial}"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !Accounts.HasAvatar}" />
                <Image Source="{Binding Accounts.SelectedAvatar}"
                       Width="26" Height="26"
                       RenderOptions.BitmapInterpolationMode="None"
                       IsVisible="{Binding Accounts.HasAvatar}" />
              </Panel>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Accounts.SelectedName}" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding Accounts.SelectedKindLabel}" FontSize="10"
                         Foreground="{DynamicResource TextFaintBrush}" />
            </StackPanel>
            <Path Classes="icon" Width="14" Height="14"
                  Data="{StaticResource IconChevronDown}" />
          </StackPanel>
        </Button>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Name="ErrorButton" Classes="chrome" Command="{Binding Errors.ToggleCommand}"
                  IsVisible="{Binding Errors.HasErrors}" ToolTip.Tip="Errors">
            <Panel>
              <Path Classes="icon" Width="15" Height="15" Data="{StaticResource IconAlert}"
                    Stroke="{DynamicResource DangerBrush}" />
              <Border Background="{DynamicResource DangerBrush}" CornerRadius="7"
                      MinWidth="14" Height="14" Margin="0,-10,-10,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{Binding Errors.BadgeText}" FontSize="9" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="3,0" />
              </Border>
            </Panel>
          </Button>
          <Popup PlacementTarget="{Binding #ErrorButton}" Placement="BottomEdgeAlignedRight"
                 IsLightDismissEnabled="True" IsOpen="{Binding Errors.IsOpen, Mode=TwoWay}">
            <Border Classes="popIn" Width="420" MaxHeight="460" Margin="0,6,0,0"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="12">
              <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,2,0,10">
                  <TextBlock Classes="label" Text="ERRORS" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="ghost" Padding="9,5" FontSize="11" Content="Copy all"
                            Command="{Binding Errors.CopyAllCommand}" />
                    <Button Classes="ghost" Padding="9,5" FontSize="11" Content="Clear"
                            Command="{Binding Errors.ClearCommand}" />
                  </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1">
                  <ItemsControl ItemsSource="{Binding Errors.Errors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource BgElevatedBrush}" CornerRadius="10"
                                Padding="11,9" Margin="0,0,0,7">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,8,0">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                              <SelectableTextBlock Text="{Binding Detail}" FontSize="11"
                                                   FontFamily="Consolas,monospace" MaxLines="4"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                              <TextBlock Text="{Binding TimeLabel}" FontSize="10"
                                         Foreground="{DynamicResource TextFaintBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost" Padding="9,6" FontSize="11"
                                    VerticalAlignment="Top" Content="Copy"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Errors.CopyOneCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Popup>
          <Button Classes="chrome" Click="OnMinimize">
            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconMinimize}" />
          </Button>
          <Button Classes="chrome" Click="OnMaximize">
            <Path Classes="icon" Width="13" Height="13" Data="{StaticResource IconMaximize}" />
          </Button>
          <Button Classes="chrome danger" Click="OnClose">
            <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconClose}" />
          </Button>
        </StackPanel>

        <Popup PlacementTarget="{Binding #AccountButton}"
               Placement="BottomEdgeAlignedRight"
               IsLightDismissEnabled="True"
               IsOpen="{Binding Accounts.IsOpen, Mode=TwoWay}">
          <Border Classes="popIn"
                  Background="{DynamicResource BgCardBrush}"
                  BorderBrush="{DynamicResource BorderStrongBrush}"
                  BorderThickness="1" CornerRadius="15" Padding="11"
                  Width="330" Margin="0,7,0,0">
            <StackPanel Spacing="8">

              <TextBlock Classes="label" Text="ACCOUNTS" Margin="6,4,0,0" />

              <ItemsControl ItemsSource="{Binding Accounts.Accounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="acc:Account">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                      <Button Grid.Column="0" Classes="nav" Padding="8"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Accounts.SelectAccountCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Border Width="30" Height="30" CornerRadius="9" ClipToBounds="True"
                                  Background="{DynamicResource AccentDeepBrush}">
                            <Panel>
                              <TextBlock Text="{Binding Username[0]}" FontSize="12" FontWeight="Bold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <Image Source="{Binding Converter={x:Static ctrl:AccountAvatarConverter.Instance}}"
                                     Width="30" Height="30" Stretch="UniformToFill" />
                            </Panel>
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Username}" FontSize="12.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Kind}" FontSize="10"
                                       Foreground="{DynamicResource TextFaintBrush}" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="1" Classes="chrome" Width="32" Height="32"
                              ToolTip.Tip="Choose image / logo for account"
                              Click="OnChangeAccountLogo" Tag="{Binding}">
                        <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconImage}" />
                      </Button>
                      <Button Grid.Column="2" Classes="chrome" Width="32" Height="32"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Accounts.RemoveAccountCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconTrash}" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,4" />

              <StackPanel IsVisible="{Binding !Accounts.IsAddingLocal}" Spacing="5">
                <Button Classes="nav" Command="{Binding Accounts.AddMicrosoftCommand}"
                        IsEnabled="{Binding !Accounts.IsSigningIn}">
                  <StackPanel Orientation="Horizontal" Spacing="11">
                    <Path Classes="icon" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Add Microsoft account" VerticalAlignment="Center" FontSize="12.5" />
                  </StackPanel>
                </Button>
                <Button Classes="nav" Command="{Binding Accounts.BeginAddLocalCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="11">
                    <Path Classes="icon" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Add local account" VerticalAlignment="Center" FontSize="12.5" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <StackPanel IsVisible="{Binding Accounts.IsAddingLocal}" Spacing="9" Margin="4">
                <TextBlock Classes="label" Text="USERNAME" />
                <TextBox Classes="field" PlaceholderText="Any username you like"
                         Text="{Binding Accounts.NewLocalUsername, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Padding="17,8" Content="Create"
                          Command="{Binding Accounts.ConfirmAddLocalCommand}" />
                  <Button Classes="ghost" Content="Cancel"
                          Command="{Binding Accounts.CancelAddLocalCommand}" />
                </StackPanel>
              </StackPanel>

              <Border IsVisible="{Binding Accounts.HasDeviceCode}"
                      Background="{DynamicResource BgElevatedBrush}" CornerRadius="11" Padding="13">
                <StackPanel Spacing="9">
                  <TextBlock Classes="label" Text="ENTER THIS CODE" />
                  <Grid ColumnDefinitions="*,Auto">
                    <SelectableTextBlock Grid.Column="0" Text="{Binding Accounts.DeviceCode}"
                                         FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                                         Foreground="{DynamicResource AccentBrush}" />
                    <Button Grid.Column="1" Classes="ghost" Padding="11,7"
                            ToolTip.Tip="Copy the code again"
                            Command="{Binding Accounts.CopyCodeCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconCheck}" />
                        <TextBlock Text="Copy" FontSize="12" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <Button Classes="ghost" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center"
                          Command="{Binding Accounts.OpenVerificationPageCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Classes="icon" Width="14" Height="14" Data="{StaticResource IconGlobe}" />
                      <TextBlock Text="Open the sign-in page again" FontSize="12" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding Accounts.StatusMessage}" FontSize="11" Margin="6,0,6,4"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextMutedBrush}"
                         IsVisible="{Binding Accounts.StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

            </StackPanel>
          </Border>
        </Popup>

      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="228,*">

      <Border Grid.Column="0" Background="{DynamicResource BgElevatedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- ── Brand header ──────────────────────── -->
          <Border Grid.Row="0" Padding="18,20,18,18"
                  BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#241435" Offset="0"/>
                <GradientStop Color="#14101E" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*">
              <!-- Logo square -->
              <Border Grid.Column="0" Width="42" Height="42" CornerRadius="13"
                      VerticalAlignment="Center" Margin="0,0,13,0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#CC55EE" Offset="0"/>
                    <GradientStop Color="#8840BB" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Image Source="{DynamicResource VesperLogo}" Width="22" Height="22"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <!-- Name + tagline -->
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Vesper" FontWeight="Bold" FontSize="17"
                           FontFamily="{StaticResource FontDisplay}"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="LAUNCHER" FontSize="9" FontWeight="Bold"
                           LetterSpacing="2.5"
                           Foreground="{DynamicResource AccentBrush}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- ── Nav items ─────────────────────────── -->
          <StackPanel Grid.Row="1" Spacing="2" Margin="10,14,10,14">

            <Grid ColumnDefinitions="3,*">
              <Border Grid.Column="0" Classes="navPip" Classes.on="{Binding IsPlayTab}" Margin="0,10" />
              <Button Grid.Column="1" Classes="nav" Classes.active="{Binding IsPlayTab}"
                      Command="{Binding SelectTabCommand}" CommandParameter="Play">
                <StackPanel Orientation="Horizontal" Spacing="13">
                  <Path Classes="icon solid" Data="{StaticResource IconPlay}" />
                  <TextBlock Text="Play" VerticalAlignment="Center" FontSize="13.5" />
                </StackPanel>
              </Button>
            </Grid>

            <Grid ColumnDefinitions="3,*">
              <Border Grid.Column="0" Classes="navPip" Classes.on="{Binding IsSkinsTab}" Margin="0,10" />
              <Button Grid.Column="1" Classes="nav" Classes.active="{Binding IsSkinsTab}"
                      Command="{Binding SelectTabCommand}" CommandParameter="Skins">
                <StackPanel Orientation="Horizontal" Spacing="13">
                  <Path Classes="icon" Data="{StaticResource IconUser}" />
                  <TextBlock Text="Skins" VerticalAlignment="Center" FontSize="13.5" />
                </StackPanel>
              </Button>
            </Grid>

            <Grid ColumnDefinitions="3,*">
              <Border Grid.Column="0" Classes="navPip" Classes.on="{Binding IsServersTab}" Margin="0,10" />
              <Button Grid.Column="1" Classes="nav" Classes.active="{Binding IsServersTab}"
                      Command="{Binding SelectTabCommand}" CommandParameter="Servers">
                <StackPanel Orientation="Horizontal" Spacing="13">
                  <Path Classes="icon" Data="{StaticResource IconServer}" />
                  <TextBlock Text="Servers" VerticalAlignment="Center" FontSize="13.5" />
                </StackPanel>
              </Button>
            </Grid>

            <Grid ColumnDefinitions="3,*">
              <Border Grid.Column="0" Classes="navPip" Classes.on="{Binding IsSettingsTab}" Margin="0,10" />
              <Button Grid.Column="1" Classes="nav" Classes.active="{Binding IsSettingsTab}"
                      Command="{Binding SelectTabCommand}" CommandParameter="Settings">
                <StackPanel Orientation="Horizontal" Spacing="13">
                  <Path Classes="icon" Data="{StaticResource IconSettings}" />
                  <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="13.5" />
                </StackPanel>
              </Button>
            </Grid>

          </StackPanel>

          <!-- ── Footer / status ───────────────────── -->
          <Border Grid.Row="2" Padding="15,11,15,14"
                  BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"
                         MaxLines="3" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="{Binding Version, StringFormat='Vesper {0}'}" FontSize="10"
                         Foreground="{DynamicResource TextFaintBrush}" />
            </StackPanel>
          </Border>

        </Grid>
      </Border>

      <TransitioningContentControl Grid.Column="1" Content="{Binding CurrentPage}">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.22" />
        </TransitioningContentControl.PageTransition>
        <TransitioningContentControl.DataTemplates>
          <DataTemplate DataType="vm:PlayViewModel">
            <views:PlayView />
          </DataTemplate>
          <DataTemplate DataType="vm:SkinsViewModel">
            <views:SkinsView />
          </DataTemplate>
          <DataTemplate DataType="vm:ServersViewModel">
            <views:ServersView />
          </DataTemplate>
          <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
          </DataTemplate>
        </TransitioningContentControl.DataTemplates>
      </TransitioningContentControl>

    </Grid>

    <views:ModsOverlay Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding Play.Mods}" />

    <views:ThemeEditorOverlay Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding Settings.Editor}" />

  </Grid>
</Window>
