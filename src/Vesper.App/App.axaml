<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vesper.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="FontSans">avares://VesperLauncher/Assets/Fonts/Geist.ttf#Geist</FontFamily>
      <FontFamily x:Key="FontDisplay">avares://VesperLauncher/Assets/Fonts/SpaceGrotesk.ttf#Space Grotesk</FontFamily>
      <FontFamily x:Key="FontPixel">avares://VesperLauncher/Assets/Fonts/PixelifySans.ttf#Pixelify Sans</FontFamily>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://VesperLauncher/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://VesperLauncher/Assets/Styles.axaml" />
  </Application.Styles>

</Application>
